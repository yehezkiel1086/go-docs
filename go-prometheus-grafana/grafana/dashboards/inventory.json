{
  "id": null,
  "uid": "inventory",
  "title": "Inventory System",
  "tags": ["inventory", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Stock Update Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(inventory_stock_updates_total[5m])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line"}
        }
      }
    },
    {
      "id": 2,
      "title": "Total Products",
      "type": "stat",
      "targets": [
        {
          "expr": "inventory_products_total",
          "legendFormat": "SKUs",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Low Stock Alerts",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(inventory_low_stock_alerts_total[1h])",
          "legendFormat": "Last Hour",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 4,
      "title": "Transaction Duration (p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(inventory_transaction_duration_seconds_bucket[5m]))",
          "legendFormat": "p99 latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(inventory_transaction_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency",
          "refId": "B"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line"}
        }
      }
    },
    {
      "id": 5,
      "title": "Stock Updates by Action",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (action) (inventory_stock_updates_total)",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}